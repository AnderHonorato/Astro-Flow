# ── Banco ────────────────────────────────────────────────────────────────
# Padrao: SQLite, roda sem infraestrutura nenhuma.
DATABASE_URL="file:./dev.db"
#
# Para Postgres (docker compose up -d postgres), troque o provider em
# prisma/schema.prisma para "postgresql" e use:
# DATABASE_URL="postgresql://astros:astros@localhost:5433/astros?schema=public"

# ── Servidor ─────────────────────────────────────────────────────────────
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ── Auth ─────────────────────────────────────────────────────────────────
# Troque em producao: openssl rand -base64 48
JWT_SECRET="dev-only-nao-use-em-producao-troque-este-segredo-agora"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────────
WEB_ORIGIN="http://localhost:3000"

# ── Geocodificacao ───────────────────────────────────────────────────────
# Open-Meteo e gratuito e nao pede chave. Deixe vazio para usar somente o
# catalogo local de cidades semeado no banco.
GEOCODING_API_URL="https://geocoding-api.open-meteo.com/v1/search"
GEOCODING_ENABLED=true
